<style>
    .accordion-content { display: none; }
    .accordion-item.active .accordion-content { display: block; }
    .accordion-item.active .accordion-icon { transform: rotate(180deg); }
</style>

<script>
    document.getElementById('startQuizBtn').addEventListener('click', function() {
        this.classList.add('hidden');
        document.getElementById('quiz-content-wrapper').classList.remove('hidden');
    });

    document.getElementById('submitQuiz').addEventListener('click', function() {
        const questions = document.querySelectorAll('.quiz-question');
        let score = 0;
        let answeredCount = 0;

        questions.forEach((q, index) => {
            const selected = q.querySelector('input[type="radio"]:checked');
            const feedback = q.querySelector('.quiz-feedback');
            feedback.classList.remove('hidden');

            if (selected) {
                answeredCount++;
                const val = parseInt(selected.value);
                const correctVal = parseInt(q.getAttribute('data-answer'));

                if (val === correctVal) {
                    score++;
                    feedback.textContent = "✅ ถูกต้อง! คุณเลือกแนวทางที่ปลอดภัย";
                    feedback.className = "quiz-feedback mt-3 text-[13px] font-semibold text-emerald-400";
                } else {
                    feedback.textContent = "❌ ยังไม่ถูกต้อง ลองศึกษาวิธีป้องกันในด้านบนดูอีกครั้งนะ";
                    feedback.className = "quiz-feedback mt-3 text-[13px] font-semibold text-red-400";
                }
            } else {
                feedback.textContent = "⚠️ คุณยังไม่ได้เลือกคำตอบข้อนี้";
                feedback.className = "quiz-feedback mt-3 text-[13px] font-semibold text-amber-400";
            }
        });

        if (answeredCount > 0) {
            const resultDiv = document.getElementById('quiz-result');
            resultDiv.classList.remove('hidden');
            resultDiv.textContent = `🎉 คุณทำคะแนนได้ ${score} จาก ${questions.length} คะแนน!`;
        }
    });
</script>

