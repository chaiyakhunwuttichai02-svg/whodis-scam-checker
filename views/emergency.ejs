                    <div class="w-12 h-12 rounded-2xl bg-primary-text text-white flex items-center justify-center shrink-0 font-bold">
                        3
                    </div>
                    <div>
                        <span class="text-[11px] font-bold text-muted-text uppercase tracking-wider">ขั้นที่ 3</span>
