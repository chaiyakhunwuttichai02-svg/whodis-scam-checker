                    </div>
                </div>
                <a href="tel:1333" class="bg-gray-100 hover:bg-gray-200 text-primary-text text-[13px] font-bold px-4 py-2 rounded-xl whitespace-nowrap self-end sm:self-center transition-colors">โทรธนาคาร</a>
            </div>

            <div class="bg-white border border-gray-200 rounded-2xl p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-sm">
