<%- include('header') %>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<main class="w-full pt-10 pb-20 bg-base-bg">
    <div class="max-w-[1000px] mx-auto px-4">
        
        <div class="text-center mb-8">
            <h1 class="text-[32px] md:text-[36px] font-bold text-primary-text mb-2">Scam Trend Dashboard</h1>
            <p class="text-muted-text text-[15px]">ภาพรวมสถานการณ์การโกงและแนวโน้มเปรียบเทียบรายเดือน</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <div class="bg-white border border-gray-200 rounded-3xl p-6 shadow-sm flex flex-col justify-center">
                <span class="text-[13px] font-semibold text-muted-text uppercase tracking-wider mb-1">รายงานทั้งหมด</span>
                <div class="text-[40px] font-bold text-primary-text leading-none">2,980</div>
                <div class="text-[12px] text-muted-text mt-2 flex items-center gap-1">
                    <span class="material-symbols-outlined text-[14px]">history</span> 6 เดือนที่ผ่านมา
                </div>
            </div>
            <div class="bg-white border border-gray-200 rounded-3xl p-6 shadow-sm flex flex-col justify-center">
                <span class="text-[13px] font-semibold text-muted-text uppercase tracking-wider mb-1">เดือนนี้</span>
                <div class="flex items-end gap-3">
                    <div class="text-[40px] font-bold text-danger leading-none">740</div>
                    <div class="text-[14px] font-bold text-danger bg-red-50 px-2 py-1 rounded mb-1 flex items-center">
                        <span class="material-symbols-outlined text-[16px]">arrow_upward</span> 21%
                    </div>
                </div>
                <div class="text-[12px] text-muted-text mt-2 flex items-center gap-1">
                    <span class="material-symbols-outlined text-[14px]">trending_up</span> เทียบกับเดือนที่แล้ว
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
            <div class="bg-white border border-gray-200 rounded-3xl p-6 md:p-8 shadow-sm">
                <h3 class="text-[18px] font-bold text-primary-text mb-6">สัดส่วนประเภท Scam (เดือนนี้)</h3>
                <div class="relative h-[250px] w-full flex justify-center mb-6">
                    <canvas id="doughnutChart"></canvas>
                    <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                        <span class="text-[12px] text-muted-text">อันดับ 1</span>
                        <span class="text-[20px] font-bold text-primary-text leading-tight mt-1">Investment</span>
                        <span class="text-[24px] font-bold text-[#3b82f6] leading-tight">32%</span>
                    </div>
                </div>
                
                <div class="space-y-3">
                    <div class="flex items-center justify-between text-[14px]">
                        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-[#3b82f6]"></span> <span class="font-medium text-primary-text">Investment Scam</span></div>
                        <span class="font-bold">32%</span>
                    </div>
                    <div class="flex items-center justify-between text-[14px]">
                        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-[#10b981]"></span> <span class="text-muted-text">Online Shopping Scam</span></div>
                        <span class="font-medium">24%</span>
                    </div>
                    <div class="flex items-center justify-between text-[14px]">
                        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-[#f59e0b]"></span> <span class="text-muted-text">Loan Scam</span></div>
                        <span class="font-medium">18%</span>
                    </div>
                    <div class="flex items-center justify-between text-[14px]">
                        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-[#ef4444]"></span> <span class="text-muted-text">Romance Scam</span></div>
                        <span class="font-medium">10%</span>
                    </div>
                    <div class="flex items-center justify-between text-[14px]">
                        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-[#8b5cf6]"></span> <span class="text-muted-text">Crypto Scam</span></div>
                        <span class="font-medium">8%</span>
                    </div>
                    <div class="flex items-center justify-between text-[14px]">
                        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-[#64748b]"></span> <span class="text-muted-text">Call Center Scam</span></div>
                        <span class="font-medium">5%</span>
                    </div>
                    <div class="flex items-center justify-between text-[14px]">
                        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-[#e2e8f0]"></span> <span class="text-muted-text">อื่นๆ</span></div>
                        <span class="font-medium">3%</span>
                    </div>
                </div>
            </div>

            <div class="bg-white border border-gray-200 rounded-3xl p-6 md:p-8 shadow-sm flex flex-col">
                <div class="flex items-start justify-between mb-6">
                    <h3 class="text-[18px] font-bold text-primary-text">เปรียบเทียบแนวโน้ม vs เดือนก่อน</h3>
                    <div class="text-right">
                        <span class="text-[12px] text-muted-text block mb-1">Investment vs เดือนก่อน</span>
                        <span class="inline-flex items-center text-[14px] font-bold text-danger bg-red-50 px-2 py-0.5 rounded">
                            <span class="material-symbols-outlined text-[16px]">trending_up</span> 35%
                        </span>
                    </div>
                </div>
                
                <div class="flex-grow w-full h-[300px] mb-6">
                    <canvas id="barChart"></canvas>
                </div>

                <div class="bg-gray-50 border border-gray-200 p-4 rounded-xl text-[13px] text-muted-text flex items-center justify-center gap-4">
                    <div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-danger"></span> สีแดง = เพิ่มขึ้น (อันตราย)</div>
                    <div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-success"></span> สีเขียว = ลดลง (ดีขึ้น)</div>
                </div>
            </div>
        </div>

        <div class="bg-white border border-gray-200 rounded-3xl p-6 md:p-8 shadow-sm">
            <h3 class="text-[18px] font-bold text-primary-text mb-6">แนวโน้มรายงานรายเดือน (ภาพรวม)</h3>
            <div class="w-full h-[300px]">
                <canvas id="lineChart"></canvas>
            </div>
        </div>

    </div>
</main>

<script>
    Chart.defaults.font.family = "'Inter', 'Noto Sans Thai', sans-serif";
    Chart.defaults.color = '#64748b';
    
    const ctxDoughnut = document.getElementById('doughnutChart').getContext('2d');
    new Chart(ctxDoughnut, {
        type: 'doughnut',
        data: {
            labels: ['Investment', 'Online Shopping', 'Loan', 'Romance', 'Crypto', 'Call Center', 'อื่นๆ'],
            datasets: [{
                data: [32, 24, 18, 10, 8, 5, 3],
                backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#64748b', '#e2e8f0'],
                borderWidth: 0,
                hoverOffset: 4
            }]
        },
        options: {
            cutout: '75%',
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } }
        }
    });

    const ctxBar = document.getElementById('barChart').getContext('2d');
    new Chart(ctxBar, {
        type: 'bar',
        data: {
            labels: ['Investment', 'Online Shopping', 'Loan', 'Romance', 'Crypto', 'Call Center', 'อื่นๆ'],
            datasets: [{
                label: '% เปลี่ยนแปลง',
                data: [35, -12, 5, 8, 22, -10, 0],
                backgroundColor: function(context) {
                    const value = context.dataset.data[context.dataIndex];
                    return value > 0 ? '#ef4444' : (value < 0 ? '#10b981' : '#e2e8f0');
                },
                borderRadius: 4
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { color: '#f1f5f9' } },
                y: { grid: { display: false } }
            }
        }
    });

    const ctxLine = document.getElementById('lineChart').getContext('2d');
    new Chart(ctxLine, {
        type: 'line',
        data: {
            labels: ['เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.'],
            datasets: [{
                label: 'จำนวนรายงานต่อเดือน',
                data: [420, 510, 480, 620, 580, 740],
                borderColor: '#1e293b',
                backgroundColor: 'rgba(30, 41, 59, 0.1)',
                borderWidth: 2,
                tension: 0.4,
                fill: true,
                pointBackgroundColor: '#ffffff',
                pointBorderColor: '#1e293b',
                pointBorderWidth: 2,
                pointRadius: 4,
                pointHoverRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                x: { grid: { display: false } }
            }
        }
    });
</script>

<footer class="w-full pb-8 pt-4 border-t border-gray-200 mt-auto">
    <div class="max-w-[1000px] mx-auto px-4 text-center">
        <div class="flex items-center justify-center gap-1 mb-2">
            <span class="material-symbols-outlined text-[16px] text-primary-text">verified_user</span>
            <span class="font-bold text-[14px] text-primary-text">Whodis</span>
        </div>
        <p class="text-[12px] text-muted-text">Check Before You Pay — เช็กก่อนโอนทุกครั้ง ป้องกันดีกว่าแก้</p>
    </div>
</footer>

</body>
</html>