<%- include('header') %>

<main class="w-full pt-10 pb-12 bg-gray-50/30">
    <div class="max-w-[1000px] mx-auto px-4">
        
        <!-- ส่วนค้นหาหลัก (แสดงตลอดเวลา) -->
        <div class="text-center flex flex-col items-center mt-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-white border border-gray-200 text-gray-500 text-[13px] font-semibold rounded-full mb-6 shadow-sm">
                <span class="material-symbols-outlined text-[16px]">shield</span> Check Before You Pay
            </div>
            
            <h1 class="text-[40px] md:text-[56px] font-bold text-gray-900 leading-tight mb-4">
                เช็กก่อนโอน <br> <span class="text-red-600">ก่อนสูญเงิน</span>
            </h1>
            
            <p class="text-gray-500 text-[15px] md:text-[18px] max-w-2xl leading-relaxed mb-8">
                แพลตฟอร์มตรวจสอบมิจฉาชีพจากข้อมูลรายงานจริงและ AI วิเคราะห์ความเสี่ยง 
                เปลี่ยนพฤติกรรมจาก "โดนโกงแล้วค่อยแจ้ง" เป็น "ตรวจสอบล่วงหน้าก่อนสูญเงิน"
            </p>

            <div class="w-full max-w-3xl bg-white p-3 rounded-2xl border border-gray-200 shadow-[0_8px_30px_rgb(0,0,0,0.04)] mb-4">
                <form action="/" method="GET" class="flex flex-col sm:flex-row items-center gap-3">
                    <div class="relative flex-1 w-full flex items-center">
                        <span class="material-symbols-outlined absolute left-4 text-gray-400 text-[24px]">search</span>
                        <!-- เพิ่ม value เพื่อให้พิมพ์แล้วค้างค่าเดิมไว้ -->
                        <input class="w-full h-[54px] pl-[50px] pr-4 bg-transparent text-[16px] text-gray-900 placeholder:text-gray-400 border-none focus:outline-none focus:ring-0" 
                               name="search" 
                               value="<%= searchTerm %>" 
                               placeholder="ลองค้นหาเบอร์หรือเลขบัญชีที่สงสัย เช่น 081-234-5678 หรือ 123-4-56789-0" 
                               type="text" 
                               minlength="4" 
                               required />
                    </div>
                    <button class="w-full sm:w-auto h-[54px] px-10 bg-gray-900 hover:bg-gray-800 text-white text-[16px] font-bold rounded-xl flex items-center justify-center gap-2 transition-transform hover:scale-[1.02]" type="submit">
                        เช็ก
                    </button>
                </form>
            </div>
            <div class="flex items-center gap-2 text-[13px] text-gray-500 mb-8">
                <span class="material-symbols-outlined text-[16px] text-emerald-500">check_circle</span> ฟรี ไม่ต้องสมัคร - ใช้งานได้ทันที
            </div>
        </div>

        <!-- ========================================== -->
        <!-- ส่วนแสดงผลลัพธ์การค้นหา (จะโผล่มาแค่ตอนค้นหา) -->
        <!-- ========================================== -->
        <% if (hasSearched) { %>
            <div class="w-full max-w-3xl mx-auto mb-16" id="search-result">
                <% if (searchError !== '') { %>
                    <!-- กรณีพิมพ์ผิดหรือ Error -->
                    <div class="p-4 bg-red-50 border border-red-200 text-red-600 rounded-xl flex items-center justify-center gap-2 shadow-sm">
                        <span class="material-symbols-outlined">error</span> <%= searchError %>
                    </div>
                <% } else if (searchResults.length > 0) { %>
                    <!-- กรณีพบประวัติ (กล่องแดง) -->
                    <div class="p-6 bg-red-50 border border-red-200 rounded-2xl mb-4 text-center shadow-sm">
                        <span class="material-symbols-outlined text-red-600 text-[48px] mb-2">warning</span>
                        <h2 class="text-[24px] font-bold text-red-700 mb-1">High Risk - พบประวัติความเสี่ยง!</h2>
                        <p class="text-red-600/80">พบข้อมูล "<%= searchTerm %>" ในฐานข้อมูล โปรดระงับการโอนเงินทันที</p>
                    </div>
                    
                    <div class="space-y-4">
                        <% searchResults.forEach(row => { %>
                        <div class="bg-white border border-gray-200 p-5 rounded-xl shadow-sm">
                            <div class="flex justify-between items-start mb-3">
                                <div>
                                    <h3 class="font-bold text-[16px] text-gray-900"><%= row.scammer_name %></h3>
                                    <p class="text-[14px] font-mono text-gray-500 mt-1">บัญชี/เบอร์: <%= row.bank_account %></p>
                                </div>
                                <span class="text-[12px] text-gray-500 bg-gray-100 px-2 py-1 rounded font-medium">
                                    <% 
                                    const dateObj = new Date(row.incident_date || row.created_at);
                                    const formattedDate = dateObj.toLocaleDateString('th-TH', { day: '2-digit', month: 'short', year: 'numeric' });
                                    %>
                                    <%= formattedDate %>
                                </span>
                            </div>
                            <p class="text-[14px] text-gray-700 bg-gray-50 p-3 rounded-lg border border-gray-100"><%= row.incident_details %></p>
                        </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <!-- กรณีไม่พบประวัติ (กล่องเขียว) -->
                    <div class="p-8 bg-emerald-50 border border-emerald-200 rounded-2xl text-center shadow-sm">
                        <span class="material-symbols-outlined text-emerald-500 text-[56px] mb-3">verified_user</span>
                        <h2 class="text-[22px] font-bold text-emerald-700 mb-2">ยังไม่พบประวัติในระบบ</h2>
                        <p class="text-emerald-700/80 text-[14px] max-w-md mx-auto">
                            การไม่พบประวัติ ไม่ได้การันตีว่าปลอดภัย 100% โปรดตรวจสอบความน่าเชื่อถือของร้านค้าหรือบุคคลนั้นอีกครั้งก่อนตัดสินใจโอนเงิน
                        </p>
                    </div>
                <% } %>
            </div>
            
            <!-- สคริปต์เลื่อนหน้าจอลงมาที่กล่องผลลัพธ์อัตโนมัติ -->
            <script>
                document.getElementById('search-result').scrollIntoView({ behavior: 'smooth', block: 'center' });
            </script>
        <% } %>
        <!-- ========================================== -->


        <!-- ระดับความเสี่ยง -->
        <div class="border-t border-gray-200 pt-10 text-center <% if(!hasSearched) { %>mt-8<% } %>">
            <h3 class="text-[13px] text-gray-500 font-bold mb-5 tracking-wider">ระดับความเสี่ยงที่ใช้ทั่วทั้งแพลตฟอร์ม</h3>
            <div class="flex flex-wrap justify-center gap-4">
                <div class="flex items-center gap-2 bg-white px-5 py-2.5 rounded-full border border-gray-200 shadow-sm hover:shadow transition">
                    <div class="w-3 h-3 rounded-full bg-emerald-500"></div>
                    <span class="text-[14px] font-bold text-gray-800">Low Risk</span>
                    <span class="text-[13px] text-gray-500 hidden sm:inline">- ประวัติใส</span>
                </div>
                <div class="flex items-center gap-2 bg-white px-5 py-2.5 rounded-full border border-gray-200 shadow-sm hover:shadow transition">
                    <div class="w-3 h-3 rounded-full bg-orange-400"></div>
                    <span class="text-[14px] font-bold text-gray-800">Medium Risk</span>
                    <span class="text-[13px] text-gray-500 hidden sm:inline">- พบรายงานบ้าง</span>
                </div>
                <div class="flex items-center gap-2 bg-white px-5 py-2.5 rounded-full border border-gray-200 shadow-sm hover:shadow transition">
                    <div class="w-3 h-3 rounded-full bg-red-500"></div>
                    <span class="text-[14px] font-bold text-gray-800">High Risk</span>
                    <span class="text-[13px] text-gray-500 hidden sm:inline">- พบรายงานหลายครั้ง</span>
                </div>
            </div>
        </div>

        <!-- 6 ฟีเจอร์หลัก -->
        <div class="mt-20 mb-8 text-center">
            <h2 class="text-[24px] md:text-[28px] font-bold text-gray-900 mb-2">ทุกฟีเจอร์เพื่อป้องกันคุณ</h2>
            <p class="text-[15px] text-gray-500">ตั้งแต่ก่อนโอน จนถึงกรณีที่โดนโกงแล้ว พร้อมดูแลทุกขั้นตอน</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 md:gap-6">
            <a href="/" class="bg-white border border-gray-200 p-6 rounded-2xl hover:shadow-md transition-all group">
                <div class="w-12 h-12 bg-gray-50 rounded-full flex items-center justify-center mb-4 group-hover:bg-gray-100">
                    <span class="material-symbols-outlined text-gray-900">search</span>
                </div>
                <h3 class="font-bold text-[16px] text-gray-900 mb-1">Check Before You Pay</h3>
                <p class="text-[13px] text-gray-500 leading-relaxed">จำลองหน้าจอก่อนโอน พร้อมเหตุผลและคำแนะนำที่ชัดเจน</p>
            </a>
            <a href="/checker" class="bg-white border border-gray-200 p-6 rounded-2xl hover:shadow-md transition-all group">
                <div class="w-12 h-12 bg-gray-50 rounded-full flex items-center justify-center mb-4 group-hover:bg-gray-100">
                    <span class="material-symbols-outlined text-gray-900">smart_toy</span>
                </div>
                <h3 class="font-bold text-[16px] text-gray-900 mb-1">Scam Checker</h3>
                <p class="text-[13px] text-gray-500 leading-relaxed">ค้นหาเบอร์/บัญชี/URL และอัปโหลดภาพให้ AI วิเคราะห์ความเสี่ยง</p>
            </a>
            <a href="/report" class="bg-white border border-gray-200 p-6 rounded-2xl hover:shadow-md transition-all group">
                <div class="w-12 h-12 bg-gray-50 rounded-full flex items-center justify-center mb-4 group-hover:bg-gray-100">
                    <span class="material-symbols-outlined text-gray-900">campaign</span>
                </div>
                <h3 class="font-bold text-[16px] text-gray-900 mb-1">แจ้งมิจฉาชีพ</h3>
                <p class="text-[13px] text-gray-500 leading-relaxed">ฟอร์มรายงานแบบ Step-by-step พร้อมแนบหลักฐาน</p>
            </a>
            <a href="/stats" class="bg-white border border-gray-200 p-6 rounded-2xl hover:shadow-md transition-all group">
                <div class="w-12 h-12 bg-gray-50 rounded-full flex items-center justify-center mb-4 group-hover:bg-gray-100">
                    <span class="material-symbols-outlined text-gray-900">bar_chart</span>
                </div>
                <h3 class="font-bold text-[16px] text-gray-900 mb-1">สถิติ Scam</h3>
                <p class="text-[13px] text-gray-500 leading-relaxed">ดูแนวโน้มการโกงแบบเรียลไทม์ เปรียบเทียบรายเดือน</p>
            </a>
            <a href="/knowledge" class="bg-white border border-gray-200 p-6 rounded-2xl hover:shadow-md transition-all group">
                <div class="w-12 h-12 bg-gray-50 rounded-full flex items-center justify-center mb-4 group-hover:bg-gray-100">
                    <span class="material-symbols-outlined text-gray-900">menu_book</span>
                </div>
                <h3 class="font-bold text-[16px] text-gray-900 mb-1">รู้จักการโกง</h3>
                <p class="text-[13px] text-gray-500 leading-relaxed">เนื้อหาป้องกันและ Quiz ทดสอบสัญชาตญาณ</p>
            </a>
            <a href="/emergency" class="bg-white border border-red-100 p-6 rounded-2xl hover:shadow-md hover:border-red-200 transition-all group">
                <div class="w-12 h-12 bg-red-50 rounded-full flex items-center justify-center mb-4 group-hover:bg-red-100">
                    <span class="material-symbols-outlined text-red-600">sos</span>
                </div>
                <h3 class="font-bold text-red-600 text-[16px] mb-1">ถูกโกงแล้วทำไง</h3>
                <p class="text-[13px] text-gray-500 leading-relaxed">ขั้นตอนช่วยเหลือเร่งด่วน พร้อมเบอร์ฉุกเฉิน</p>
            </a>
        </div>

        <!-- 3 ฟีเจอร์ย่อยด้านล่างสุด -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-16 mb-10 pt-10 border-t border-gray-200">
            <div class="text-center p-4">
                <div class="w-10 h-10 mx-auto bg-gray-100 rounded-full flex items-center justify-center mb-3">
                    <span class="material-symbols-outlined text-gray-600 text-[20px]">filter_alt</span>
                </div>
                <h4 class="font-bold text-[15px] text-gray-800 mb-1">กลั่นกรองทุกรายงาน</h4>
                <p class="text-[12px] text-gray-500">รายงานต้องผ่านการตรวจสอบก่อนเผยแพร่ ป้องกันการใส่ร้าย</p>
            </div>
            <div class="text-center p-4">
                <div class="w-10 h-10 mx-auto bg-gray-100 rounded-full flex items-center justify-center mb-3">
                    <span class="material-symbols-outlined text-gray-600 text-[20px]">verified</span>
                </div>
                <h4 class="font-bold text-[15px] text-gray-800 mb-1">Badge บอกความน่าเชื่อถือ</h4>
                <p class="text-[12px] text-gray-500">แยกสถานะของแต่ละรายงานชัดเจน (ยืนยันแล้ว vs รอตรวจสอบ)</p>
            </div>
            <div class="text-center p-4">
                <div class="w-10 h-10 mx-auto bg-gray-100 rounded-full flex items-center justify-center mb-3">
                    <span class="material-symbols-outlined text-gray-600 text-[20px]">info</span>
                </div>
                <h4 class="font-bold text-[15px] text-gray-800 mb-1">Disclaimer ทุกจุด</h4>
                <p class="text-[12px] text-gray-500">ระบุชัดว่าเป็นการประเมินความเสี่ยง ไม่ใช่การตัดสิน</p>
            </div>
        </div>

    </div>
</main>

<!-- Footer ส่วนล่างสุด -->
<footer class="w-full pb-8 pt-4 border-t border-gray-200 bg-white">
    <div class="max-w-[1000px] mx-auto px-4 text-center">
        <div class="flex items-center justify-center gap-1 mb-2">
            <span class="material-symbols-outlined text-[16px] text-gray-900">verified_user</span>
            <span class="font-bold text-[14px] text-gray-900">Whodis</span>
        </div>
        <p class="text-[12px] text-gray-500">Check Before You Pay — เช็กก่อนโอนทุกครั้ง ป้องกันดีกว่าแก้</p>
        <p class="text-[11px] text-gray-400 mt-2">ต้นแบบเพื่อการสาธิต - ข้อมูลจำลอง - ไม่ใช่การยืนยันตัวตนทางการ</p>
    </div>
</footer>

</body>
</html>